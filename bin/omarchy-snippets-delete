#!/bin/bash

# Delete a snippet.
# Usage: omarchy-snippets-delete <id>
# Internal: invoked by Panel.qml via Process, not meant to be run by hand.

set -euo pipefail

source "$(dirname "$(readlink -f "$0")")/omarchy-snippets-lib"

id=${1:-}
[[ -n $id ]] || snippets_fail "Could not delete snippet."

store=$(snippets_load)

exists=$(jq -r --arg id "$id" '[.snippets[] | select(.id == $id)] | length' <<<"$store")
(( exists > 0 )) || snippets_fail "Snippet not found."

store=$(jq --arg id "$id" '.snippets |= map(select(.id != $id))' <<<"$store")
snippets_write "$store"
