# Shared helpers for the Snippet Manager CLI. Sourced by omarchy-snippets-*;
# not executable and not routed by any dispatcher.
#
# Snippet content can hold credentials (see docs/snippet-manager.md section
# 29), so every write here chmods the store to 600 before the atomic rename
# lands it in place -- FileView's own atomic write (temp file + rename) does
# not preserve a chosen mode across that rename, which is why QML never
# writes this file directly and every mutation goes through these scripts
# instead.

SNIPPETS_DIR="$HOME/.local/state/omarchy"
SNIPPETS_PATH="$SNIPPETS_DIR/snippets.json"
SNIPPETS_VERSION=1

# Reads the store through omarchy-snippets-read rather than `cat`ing
# $SNIPPETS_PATH directly: that script opens the path once with
# O_NOFOLLOW|O_NONBLOCK and validates the resulting descriptor (regular
# file, owned by us, under the size cap) before reading it, so a planted
# symlink, FIFO, or oversized file at this predictable path can't be
# followed, block the shell, or be read unbounded -- see its header for
# the full rationale.
snippets_load() {
  "$(dirname "${BASH_SOURCE[0]}")/omarchy-snippets-read" || snippets_fail "Could not read snippet store."
}

# Reads and validates a user-selected import file through
# omarchy-snippets-import-read: one no-follow/nonblocking open, fstat
# checks (regular file, self- or root-owned, size-capped), and bounds on
# record count and name/content length, all before the caller sees any of
# it. Prints the validated document; the caller never reopens $1 by path
# afterward. Failure messages (including the exact "Unsupported snippet
# format version." text callers depend on) come from that script, so this
# is deliberately not wrapped in a generic snippets_fail fallback.
snippets_load_import() {
  local file=$1
  "$(dirname "${BASH_SOURCE[0]}")/omarchy-snippets-import-read" "$file"
}

# Atomically replace the store with $1 (a JSON document), keeping it
# non-readable to other users throughout.
snippets_write() {
  local json=$1 tmp

  mkdir -p "$SNIPPETS_DIR"
  tmp=$(mktemp "$SNIPPETS_DIR/.snippets.XXXXXX")
  chmod 600 "$tmp"
  printf '%s' "$json" >"$tmp"
  mv "$tmp" "$SNIPPETS_PATH"
}

snippets_new_id() {
  cat /proc/sys/kernel/random/uuid
}

snippets_fail() {
  echo "$1" >&2
  exit 1
}

# Non-empty after trimming leading/trailing whitespace.
snippets_blank() {
  local value=$1
  [[ ${value//[$' \t\n\r']/} == "" ]]
}
